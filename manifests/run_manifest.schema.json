{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wm-policy-portfolio run manifest",
  "description": "One record per artifact-producing run (policy training, WM training, suite generation, evaluation). Frozen manifests are hash-committed at protocol freeze; the hidden-suite runner refuses to execute unless HEAD matches freeze_tag and hashes verify.",
  "type": "object",
  "required": ["kind", "env_name", "seed", "git_sha", "created_at", "command"],
  "properties": {
    "kind": {
      "enum": ["policy", "world_model", "oracle_branches", "planner_eval", "ood_suite", "certification", "hidden_eval"]
    },
    "env_name": {"type": "string", "description": "OGBench dataset name, e.g. antmaze-giant-navigate-v0"},
    "algo": {"type": "string", "description": "gcbc|gcivl|gciql|qrl|crl|hiql, or planner rung name"},
    "seed": {"type": "integer"},
    "git_sha": {"type": "string"},
    "ogbench_version": {"type": "string", "const": "1.2.1"},
    "command": {"type": "string", "description": "exact launch command"},
    "checkpoint_path": {"type": "string"},
    "checkpoint_sha256": {"type": "string"},
    "dataset_sha256": {"type": "string"},
    "flags_json_sha256": {"type": "string"},
    "transition_budget": {"type": "integer", "description": "world-model transition calls per decision (planner runs)"},
    "task_list_sha256": {"type": "string", "description": "OOD suite instance list hash (suite/eval runs)"},
    "freeze_tag": {"type": "string", "description": "git tag; required for kind=hidden_eval"},
    "slurm_job_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "notes": {"type": "string"}
  }
}
